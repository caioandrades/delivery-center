	measure 'Comparativo MoM Ot-In' = ```
			
			VAR vValor = [OnTime-InFull MoM%]
			VAR vValor_formatado = FORMAT(vValor, "0.00%") 
			VAR vMeta = 1
			VAR vCor = 
			    IF(vValor < 0, "#EF5753",
			        IF(vValor = 0, "#FFD771", "#75BB92"))
			
			VAR vDirecaoFlecha = 
			    IF(vValor > 0, "&#9650;", 
			        IF(vValor < 0, "&#9660;", "="))
			
			--------------------------------
			-- FORMATAÇÕES   
			--------------------------------
			
			VAR vFonte = "Segoe UI"
			
			VAR vRotulo_categoria_texto = "MoM:"
			VAR vRotulo_categoria_cor = vCor
			VAR vRotulo_categoria_tam = 12
			
			VAR vRotulo_dados_cor = vCor
			VAR vRotulo_dados_tam = 15
			VAR vRotulo_dados_peso = 600
			VAR vRotulo_dados_posicao = 110
			
			VAR vBarra_altura = 15
			VAR vBarra_progresso_cor = "#21A0AA"
			VAR vBarra_fundo_opacidade = 2
			VAR vLinha_meta_larg = 3
			VAR vLinha_meta_cor = "#3f3f3f"
			VAR vCor_fundo = vCor
			
			RETURN
			
			"data:image/svg+xml;utf8,
			<svg width='200' height='80' viewBox='0 0 200 80' fill='none' xmlns='http://www.w3.org/2000/svg'>
			    <!-- Retângulo de Fundo -->
			   <--! <rect id='f001' x='0' y='15' width='190' height='" & vBarra_altura & "' fill='" & vCor_fundo & "' opacity='0." & vBarra_fundo_opacidade & "' rx='5' ry='5' /> -->
			
			    <!-- Texto da Categoria -->
			    <text id='f003' fill='" & vRotulo_categoria_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_categoria_tam & "' font-weight='700'>
			        <tspan x='15' y='27'>" & vRotulo_categoria_texto & "</tspan>
			    </text>
			
			    <!-- Linha de Meta -->
			    <!-- <rect id='f005' x='" & MIN(190, MAX(0, ROUND(131 * vMeta, 0))) & " ' y='11' width='" & vLinha_meta_larg & "' height='" & vBarra_altura + 10 & "' fill='" & vLinha_meta_cor & "' /> -->
			
			    <!-- Texto de Seta para Cima, para Baixo ou Igual e Dados -->
			    <text id='f006' fill='" & vRotulo_dados_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_dados_tam & "' font-weight='" & vRotulo_dados_peso & "' text-anchor='middle' dominant-baseline='middle'>
			        <tspan x='100' y='24'>" & vDirecaoFlecha & " " & vValor_formatado & "</tspan>
			    </text>
			</svg>
			"
			```
		displayFolder: Visuais
		lineageTag: 04aef331-8530-4d43-a652-29e9f4dc8f24

