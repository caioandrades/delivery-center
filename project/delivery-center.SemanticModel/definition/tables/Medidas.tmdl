				"""" & FORMAT(SELECTEDMEASURE(), _Formato)  & """"
				```

	measure 'R$ não faturado' =
			
			/* Receita bruta não faturada são as receitas dos pedidos cancelados*/
			 CALCULATE(
			     [Receita total],
