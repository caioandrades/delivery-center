	measure '% não faturado' = ```
			
			var vFat =DIVIDE(
			        CALCULATE(
			        [Receita total], 
			        FILTER(ALL(Orders[order_status]),
			        Orders[order_status] = "CANCELED")) -- total de faturamento cancelado
			    ,
			    [Receita total] -- total de faturamento
			)
